  "claims": [
    {"claim_id": "gc-rag-basics-01", "claim_text": "RAG 在生成前检索外部知识，把非参数化知识作为当前回答的上下文。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "rag_basics", "source_document_id": "module_rag_foundations", "evidence_ids": ["ev-mod01-sec1"]},
    {"claim_id": "gc-rag-basics-02", "claim_text": "RAG-Sequence 中一条输出序列主要依赖同一组检索文档，RAG-Token 允许生成不同 token 时综合不同文档。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "rag_basics", "source_document_id": "module_rag_foundations", "evidence_ids": ["ev-mod01-sec2"]},
    {"claim_id": "gc-rag-basics-03", "claim_text": "DPR 使用双编码器分别编码问题和文本片段，文档向量可以预先计算，因此适合大规模第一阶段召回。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "rag_basics", "source_document_id": "module_rag_foundations", "evidence_ids": ["ev-mod01-sec3"]},
    {"claim_id": "gc-rag-basics-04", "claim_text": "向量相似度分数只表达模型空间中的接近程度，不能直接解释为正确概率。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "rag_basics", "source_document_id": "module_rag_foundations", "evidence_ids": ["ev-mod01-sec3"]},
    {"claim_id": "gc-rag-basics-05", "claim_text": "无证据时系统应明确拒答或降级，不把模型记忆伪装成知识库结论。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "rag_basics", "source_document_id": "module_rag_foundations", "evidence_ids": ["ev-mod01-sec7"]},
    {"claim_id": "gc-rag-basics-07", "claim_text": "RAG 主要解决知识时效性、领域覆盖和证据追溯三个问题。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "rag_basics", "source_document_id": "module_rag_foundations", "evidence_ids": ["ev-mod01-sec1"]},

    {"claim_id": "gc-doc-parsing-01", "claim_text": "PDF 是版面描述格式，不天然代表正确阅读顺序，双栏文档可能被先抽取两栏第一行再抽取两栏第二行。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "document_parsing", "source_document_id": "module_ingestion_chunking", "evidence_ids": ["ev-mod02-sec10"]},
    {"claim_id": "gc-doc-parsing-02", "claim_text": "扫描 PDF 可能没有文本层，应先判断是否存在文本层再决定是否执行 OCR。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "document_parsing", "source_document_id": "module_ingestion_chunking", "evidence_ids": ["ev-mod02-sec3"]},
    {"claim_id": "gc-doc-parsing-03", "claim_text": "URL 不是稳定版本标识，同一网页可能持续更新，关键规范应额外保留发布日期或归档信息。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "document_parsing", "source_document_id": "module_ingestion_chunking", "evidence_ids": ["ev-mod02-sec2"]},
    {"claim_id": "gc-doc-parsing-04", "claim_text": "清洗不能随意删掉否定词、单位、版本号、条件语句和警告，这些短词往往决定工程结论是否成立。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "document_parsing", "source_document_id": "module_ingestion_chunking", "evidence_ids": ["ev-mod02-sec4"]},
    {"claim_id": "gc-doc-parsing-05", "claim_text": "JSON/CSV 适合按对象、记录或业务主键切分，不能每 N 个字符截断。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "document_parsing", "source_document_id": "module_ingestion_chunking", "evidence_ids": ["ev-mod02-sec3"]},
    {"claim_id": "gc-doc-parsing-06", "claim_text": "HTML 解析应移除导航、Cookie 提示和页脚等模板噪声，但不能把表格、标题与正文错误拼接。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "document_parsing", "source_document_id": "module_ingestion_chunking", "evidence_ids": ["ev-mod02-sec3"]},

    {"claim_id": "gc-embedding-01", "claim_text": "Embedding 负责候选召回，不负责证明事实正确，也不直接生成答案。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "embedding", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec1"]},
    {"claim_id": "gc-embedding-02", "claim_text": "问答检索属于短问题找长答案的非对称任务，模型支持时应分别使用 encode_query 和 encode_document 编码查询与语料。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "embedding", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec2"]},
    {"claim_id": "gc-embedding-03", "claim_text": "向量做 L2 归一化后，余弦相似度与点积相等。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "embedding", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec10"]},
    {"claim_id": "gc-embedding-04", "claim_text": "禁止把不同模型生成的向量写进同一索引空间，即使维度相同其空间含义也不同。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "embedding", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec3"]},
    {"claim_id": "gc-embedding-05", "claim_text": "长片段超过模型最大输入长度时可能被静默截断，入库程序应记录 token 长度分布和截断数量。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "embedding", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec11"]},
    {"claim_id": "gc-embedding-06", "claim_text": "出现 NaN、维度不一致或空文本时应拒绝写入向量库，不能跳过后继续形成不完整索引。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "embedding", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec4"]},

    {"claim_id": "gc-chunking-01", "claim_text": "通用文本的切片推荐从 RecursiveCharacterTextSplitter 起步，按段落、换行和空格等分隔符逐级尝试。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "chunking", "source_document_id": "module_ingestion_chunking", "evidence_ids": ["ev-mod02-sec5"]},
    {"claim_id": "gc-chunking-02", "claim_text": "中文切片应把句号、逗号、顿号等中文标点加入分隔符，避免依赖英文空格。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "chunking", "source_document_id": "module_ingestion_chunking", "evidence_ids": ["ev-mod02-sec9"]},
    {"claim_id": "gc-chunking-03", "claim_text": "chunk_overlap 过大会产生重复召回、挤占 Top-K、提高存储成本，并让评测误以为召回了多个独立证据。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "chunking", "source_document_id": "module_ingestion_chunking", "evidence_ids": ["ev-mod02-sec6"]},
    {"claim_id": "gc-chunking-04", "claim_text": "示例代码中的 chunk_size 由 len 按字符数计算，不等于模型 token 数。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "chunking", "source_document_id": "module_ingestion_chunking", "evidence_ids": ["ev-mod02-sec9"]},
    {"claim_id": "gc-chunking-05", "claim_text": "增量更新只插入不删除会形成幽灵知识，检索仍可能召回已经撤销的规范。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "chunking", "source_document_id": "module_ingestion_chunking", "evidence_ids": ["ev-mod02-sec11"]},
    {"claim_id": "gc-chunking-06", "claim_text": "增量更新时文档未变应跳过，内容变更应重算该文档片段并删除旧片段。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "chunking", "source_document_id": "module_ingestion_chunking", "evidence_ids": ["ev-mod02-sec7"]},

    {"claim_id": "gc-vector-store-01", "claim_text": "Chroma 的 collection 是存储和查询的基本单元，不同知识库使用独立 collection 可降低误检与版本管理风险。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "vector_store", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec5"]},
