    {"claim_id": "gc-sim-retrieval-02", "claim_text": "相似度阈值必须从验证集产生，不能跨模型照搬。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "similarity_retrieval", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec8"]},
    {"claim_id": "gc-sim-retrieval-03", "claim_text": "相似度通常越大越近、距离通常越小越近，把分数方向弄反会让最差片段排到最前。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "similarity_retrieval", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec10"]},
    {"claim_id": "gc-sim-retrieval-04", "claim_text": "模型或索引版本改变后，相似度阈值必须重新校准，不能沿用旧阈值。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "similarity_retrieval", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec13"]},
    {"claim_id": "gc-sim-retrieval-05", "claim_text": "每次查询要记录实际使用的过滤器，并区分被过滤为空与语义检索失败两种情况。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "similarity_retrieval", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec7"]},
    {"claim_id": "gc-sim-retrieval-06", "claim_text": "只用 Top-K 时即使所有片段都不相关也可能硬返回 K 条，应结合阈值校准并保留无候选分支。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "similarity_retrieval", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec13"]},

    {"claim_id": "gc-prompt-01", "claim_text": "上下文组装要建立受 token 预算约束、来源明确、顺序合理的证据包，而不是简单拼接 Top-K。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "prompt_assembly", "source_document_id": "module_context_citation_grounding", "evidence_ids": ["ev-mod05-sec1"]},
