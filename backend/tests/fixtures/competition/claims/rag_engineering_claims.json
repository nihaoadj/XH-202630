    {"claim_id": "gc-prompt-04", "claim_text": "证据去重不能只比较文本完全相等，相邻重叠切片应依据文档、相邻序号和文本重叠率合并。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "prompt_assembly", "source_document_id": "module_context_citation_grounding", "evidence_ids": ["ev-mod05-sec9"]},
