    {"claim_id": "gc-vector-store-04", "claim_text": "权限必须在检索前作为过滤条件进入查询，不能先召回再靠 Prompt 要求模型保密。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "vector_store", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec9"]},
    {"claim_id": "gc-vector-store-05", "claim_text": "稳定 ID 配合 upsert 能让重复入库保持幂等。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "vector_store", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec6"]},
    {"claim_id": "gc-vector-store-06", "claim_text": "生产更新不应先删除全部旧索引再重建，可以构建新 collection 并在校验完成后切换。", "claim_type": "factual", "verdict": "supported", "knowledge_point_id": "vector_store", "source_document_id": "module_embeddings_vector_retrieval", "evidence_ids": ["ev-mod03-sec6"]},

