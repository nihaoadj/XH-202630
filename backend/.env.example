# 运行模式：development | demo | production
APP_MODE=development
# 仅 development/demo 可显式开启；production 永远禁止隐式降级
ALLOW_DEGRADED_GENERATION=false

# T49：新学习轮次创建默认关闭；不阻断既有轮次的查询、测评与本轮纠错。
LEARNING_ROUND_CREATION_ENABLED=false
# 每个成员在本轮可参与的纠错阶段数；创建时冻结，后续改配置不追溯。
LEARNING_ROUND_CORRECTION_STAGE_LIMIT=2
# 每阶段同一资源允许的显式失败恢复次数；Worker lease 恢复不计为新恢复。
LEARNING_ROUND_RESOURCE_RECOVERY_LIMIT=2
# 每份资源的输入+输出 token 预算，包含失败与重试；不是供应商账单金额。
LEARNING_ROUND_RESOURCE_TOKEN_LIMIT=1048576

# 大模型配置（支持 OpenAI 兼容接口；占位 Key 不能用于 production）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4.1-flash
# 旁路 LLM 调用计量（T41）：只观察不改业务；false 时观察与发布均为 no-op
LLM_ACCOUNTING_ENABLED=true
# 独立计量库路径（相对 backend 目录解析）；不得指向任何业务 SQLite/知识库文件或资源产物目录
LLM_ACCOUNTING_DB_PATH=./data/llm_accounting.db
# Provider-specific reasoning toggle (auto|enabled|disabled). Live acceptance uses
# disabled: the same structured task measured ~5x output tokens and ~3x latency
# with reasoning on. Re-enable only after re-deriving the timeouts below.
LLM_THINKING_MODE=disabled
# Optional. Leave blank for direct model access; system proxy settings are ignored.
# 注意：本机系统代理会让 dashscope.aliyuncs.com 的 CONNECT 无响应，手工 curl 验证时须加
# --noproxy '*'；应用侧因 trust_env=False 不受影响，确需代理才填此项。
LLM_PROXY_URL=
# 单次 Provider 请求与整个资源级工作流的超时预算（秒）
# 规则：输出上限 <= 单请求时限 x 实测吞吐；超出部分只会变成超时。
# 本模板按百炼 deepseek-v4.1-flash 关闭思考的实测 137 token/s 校准（7 组预算占用 70%–84%）。
# 换模型或换区域必须重测吞吐再复核，低于约 120 token/s 时要同步下调上限或上调时限。
LLM_REQUEST_TIMEOUT_SECONDS=180
# Claim 抽取/判定的独立预算；长资源不继承通用辅助节点限制。
CLAIM_REQUEST_TIMEOUT_SECONDS=240
CLAIM_RETRY_REQUEST_TIMEOUT_SECONDS=480
LLM_WORKFLOW_TIMEOUT_SECONDS=1800
# Deadline-aware guard: an attempt is not even started when the remaining run
# budget is below min(this value, 0.5 x the configured request timeout).
# Set it very high (e.g. 100000) to disable the guard.
LLM_MIN_ATTEMPT_SECONDS=45
# 含首次调用，允许范围 1-3；SDK 自带重试保持关闭
LLM_MAX_ATTEMPTS=2
CLAIM_MAX_ATTEMPTS=3
CLAIM_SCHEMA_REPAIR_ATTEMPTS=1
# Publish ordinary-review-approved resources with incomplete Claim metrics.
CLAIM_PARTIAL_PUBLISH=true
# Deprecated: evidence-gap resources now wait for an explicit user decision.
CLAIM_WARNING_PUBLISH_ENABLED=false
CLAIM_WARNING_PUBLISH_MIN_FACTUAL_PASS_RATE=0.80
# Completed Claim audits with evidence gaps enter user review at this rate.
CLAIM_USER_REVIEW_ENABLED=true
CLAIM_USER_REVIEW_MIN_FACTUAL_PASS_RATE=0.60
# 用户可见资源生成在空输出时允许额外一次有界恢复；审核等辅助节点仍使用上面的全局上限。
LLM_RESOURCE_GENERATION_MAX_ATTEMPTS=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=3.0
LLM_MAX_OUTPUT_TOKENS=16384
# 文本测评审核：默认保留逐题范围 + 整卷两阶段；combined_v2 为未启用候选。
ASSESSMENT_REVIEW_STRATEGY=two_stage_v1
# combined_v2 必须填写已核实的部署模型正整数窗口；未设置时不写空环境变量。
# ASSESSMENT_REVIEW_CONTEXT_TOKENS=
CLAIM_MAX_OUTPUT_TOKENS=24576
CLAIM_TRUNCATED_RETRY_OUTPUT_TOKENS=49152
# 每个资源最多抽取多少条 Claim；同时约束提示词和服务端抽取结果。
CLAIM_MAX_CLAIMS_PER_RESOURCE=10
# Default neutral_estimate_v1 needs no tokenizer/profile; legacy_v3 is an explicit rollback.
# Set the context limit for the deployed model; estimates are heuristic.
CLAIM_EXTRACTION_STRATEGY=neutral_estimate_v1
CLAIM_EXTRACTION_CONTEXT_LIMIT=1048576
CLAIM_ESTIMATE_ASCII_WEIGHT=0.3
CLAIM_ESTIMATE_CJK_WEIGHT=0.6
CLAIM_ESTIMATE_UNICODE_WEIGHT=1
CLAIM_ESTIMATE_MARGIN=0.15
CLAIM_ESTIMATE_MESSAGE_OVERHEAD=8
CLAIM_ESTIMATE_REQUEST_OVERHEAD=128
CLAIM_EXTRACTION_TARGET_TOKENS=4096
CLAIM_EXTRACTION_CONTEXT_TOKENS=512
CLAIM_EXTRACTION_BATCH_CLAIMS=16
CLAIM_EXTRACTION_RESOURCE_CLAIMS=48
CLAIM_EXTRACTION_OUTPUT_TOKENS=32768
CLAIM_EXTRACTION_MAX_CALLS=8
CLAIM_EXTRACTION_MAX_ATTEMPTS=24
CLAIM_EXTRACTION_MAX_TOKENS=196608
CLAIM_EXTRACTION_ATTEMPT_TIMEOUT_SECONDS=180
CLAIM_EXTRACTION_MAX_REQUEST_SECONDS=480
# T37 density-aware packing for neutral_estimate_v1. Frozen into each new Run;
# changing these only affects Runs frozen afterwards. Does not change batch/resource caps.
CLAIM_EXTRACTION_DENSITY_ENABLED=true
CLAIM_EXTRACTION_DENSITY_PRIOR=35
CLAIM_EXTRACTION_RISK_SHARE=0.9
# T42 programmatic source locating (neutral-v2 offset-free output). Only affects
# NEW neutral_estimate_v1 requests at freeze time; existing
# queued/running/finished Runs keep their frozen
# sub-contract. exact_v1 = neutral-v2 prompt but only unique exact locating;
# tolerant_v1 additionally enables the bounded format (B) and edit (C) layers.
# An empty value keeps the historical v1 prompt with no source-locating sub-contract.
CLAIM_EXTRACTION_SOURCE_LOCATING_MODE=tolerant_v1
# 兼容旧部署；新资源 Agent 使用下方的显式预算。
LLM_GENERATOR_MAX_OUTPUT_TOKENS=16384
LLM_RESOURCE_GENERATOR_MAX_INPUT_TOKENS=65536
# Bounds non-strict resource calls (assessment/checklist); keep <= request timeout x throughput.
LLM_RESOURCE_GENERATOR_MAX_OUTPUT_TOKENS=16384
# 讲义使用单独的、有界长文预算：给完整 Markdown 留余量，但不继承通用 32k 输出预算。
TEXT_RESOURCE_REQUEST_TIMEOUT_SECONDS=240
TEXT_RESOURCE_MAX_OUTPUT_TOKENS=24576
# 实操指南先生成严格 JSON（最多 8 步），再确定性拼接为 Markdown；保留更高的独立预算。
PRACTICE_GUIDE_REQUEST_TIMEOUT_SECONDS=300
PRACTICE_GUIDE_MAX_OUTPUT_TOKENS=32768
# auto | json_schema | function_calling | json_mode | text
# OpenAI-compatible 服务若不支持 function calling，请显式设为 text，
# 避免每个 Agent 先发生一次 BAD_REQUEST 再回退；不要修改真实密钥文件入库。
LLM_STRUCTURED_OUTPUT_MODE=json_mode

# 互动课件自动审核：达到修订或时间预算即隔离，不等待人工批准。
# Normal courseware authoring is AI-first.  Set false only for an explicit
# emergency-degraded operation; local tests inject a non-network fake gateway.
COURSEWARE_AI_ENABLED=true
# Unified content review is default-off; production tokenizer profile is required.
COURSEWARE_CONTENT_REVIEW_ENABLED=false
# After deployment verification, set an integer >=16384 (default: omitted/None):
# COURSEWARE_CONTENT_REVIEW_CONTEXT_TOKENS=...
COURSEWARE_GENERATION_MODE=ai_first
COURSEWARE_AUTO_REVISION_MAX_ATTEMPTS=3
COURSEWARE_SCENE_LEASE_SECONDS=120
COURSEWARE_AUTO_REVIEW_MAX_SECONDS=180
# 分阶段 token/时延预算；质量审核和修订预留额度不可被前序阶段占用
COURSEWARE_PLANNER_TOKEN_BUDGET=16384
COURSEWARE_TOTAL_LLM_TOKEN_BUDGET=147456
COURSEWARE_SCENE_COMPOSITION_TOKEN_BUDGET=81920
COURSEWARE_SCENE_CALL_MAX_TOKENS=8192
COURSEWARE_QUALITY_REVIEW_TOKEN_BUDGET=16384
COURSEWARE_REVISION_TOKEN_BUDGET=32768
COURSEWARE_QUALITY_REVIEW_RESERVED_TOKENS=16384
COURSEWARE_REVISION_RESERVED_TOKENS=32768
COURSEWARE_PLANNER_MAX_SECONDS=90
COURSEWARE_TOTAL_RUN_TIMEOUT_SECONDS=1050
COURSEWARE_SCENE_COMPOSITION_MAX_SECONDS=600
COURSEWARE_QUALITY_REVIEW_MAX_SECONDS=120
COURSEWARE_REVISION_MAX_SECONDS=180
COURSEWARE_QUALITY_REVIEW_RESERVED_SECONDS=120
COURSEWARE_REVISION_RESERVED_SECONDS=180
# 兼容旧配置；Web 不会自动启动 Worker，请运行 backend/scripts/courseware_worker.py
COURSEWARE_WORKER_ENABLED=false
COURSEWARE_WORKER_POLL_SECONDS=2
COURSEWARE_WORKER_BATCH_SIZE=1
# SQLite schedules one sequential Worker. Values above 1 are normalized to 1
# so an unstarted task never holds an expiring lease.
COURSEWARE_WORKER_HEALTH_HOST=127.0.0.1
COURSEWARE_WORKER_HEALTH_PORT=8081
COURSEWARE_INPUT_COST_PER_1K_TOKENS=0
COURSEWARE_OUTPUT_COST_PER_1K_TOKENS=0

# C0 live-model acceptance: every field is required by the manual job; these
# are metadata only and never contain the API key. Missing fields are reported
# as CONFIG_MISSING and cannot be reported as passed.
COURSEWARE_LIVE_MODEL_CONFIG_VERSION=2
COURSEWARE_LIVE_MODEL_PROVIDER=
COURSEWARE_LIVE_MODEL_BASE_URL=
COURSEWARE_LIVE_MODEL=
COURSEWARE_LIVE_STRUCTURED_OUTPUT_MODE=json_mode
COURSEWARE_LIVE_TIMEOUT_SECONDS=60
COURSEWARE_LIVE_MAX_ATTEMPTS=2
COURSEWARE_LIVE_RETRY_BASE_DELAY_SECONDS=0.5
COURSEWARE_LIVE_RETRY_MAX_DELAY_SECONDS=3
COURSEWARE_LIVE_INPUT_PRICE_PER_1K_TOKENS=
COURSEWARE_LIVE_OUTPUT_PRICE_PER_1K_TOKENS=
COURSEWARE_LIVE_PRICE_CURRENCY=USD
COURSEWARE_LIVE_PRICE_VERSION=
COURSEWARE_LIVE_PRICE_EFFECTIVE_DATE=2026-08-24
# COURSEWARE_LIVE_EVAL=1 is required for real calls; LLM_API_KEY is read only
# from the process environment and is never written to a report.
COURSEWARE_LIVE_EVAL=0

# Tutor independent generation budget; shared gateway retry/error semantics unchanged.
# AUTO uses JSON text with strict schema parsing; no separate support review.
TUTOR_LLM_TIMEOUT_SECONDS=25
TUTOR_MAX_OUTPUT_TOKENS=4096
TUTOR_MAX_CONTEXT_TURNS=6
TUTOR_MAX_EVIDENCE_ITEMS=4
TUTOR_MAX_HINT_LEVEL=3

# 向量模型配置
# Multilingual dense model. Provision the pinned snapshot explicitly before use;
# for offline deployment set this to its ABSOLUTE local directory (see README).
EMBEDDING_MODEL=BAAI/bge-m3
# Require the pre-provisioned local embedding model at runtime. Set false only
# while explicitly provisioning model files on a trusted network.
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_BATCH_SIZE=4

# P0-03 Evidence 检索策略（请求只能在 1-10 范围覆盖 top-k）
RETRIEVAL_TOP_K_DEFAULT=6
RETRIEVAL_MAX_QUERIES=6
# 学习文本文档：具体任务查询、来源软平衡、完整候选后置选材；false恢复旧逻辑
LEARNING_RETRIEVAL_REFINEMENT_ENABLED=true
# E1 默认关闭；实际执行建立 Run 时冻结策略，关闭不改历史证据/spec。
RESOURCE_AWARE_RETRIEVAL_ENABLED=false
RESOURCE_AWARE_RETRIEVAL_MAX_QUERIES=10
# 完整 Planner 输入以 UTF-8 字节数+1024作保守 token 估计，非精确分词。
RESOURCE_AWARE_PLANNER_INPUT_BUDGET_TOKENS=32768
# 启用前核实部署模型真实上下文窗口并填写；未设置时严格失败/按原政策降级。
# RESOURCE_AWARE_PLANNER_CONTEXT_TOKENS=<部署模型窗口>
RETRIEVAL_MAX_EVIDENCE=8
RETRIEVAL_MIN_EVIDENCE=1
RETRIEVAL_MIN_NORMALIZED_SCORE=0.35
# Verified English references get a selection-only bonus after the original relevance gate.
# 0 disables; finite range 0..0.25. Raw relevance and evidence/source validation stay unchanged.
RETRIEVAL_ENGLISH_SCORE_BONUS=0.08
# Optional KB query_aliases.json keyword probe + language-neutral dense floor.
# Disable to restore the original per-query RRF-only candidate selection.
RETRIEVAL_BALANCED_CANDIDATES_ENABLED=true
# Global reservation, not per language/query; must not exceed RERANK_CANDIDATE_K.
RETRIEVAL_DENSE_RESERVE=10
# Final SQL-validated Evidence selection only; no reingestion or model calls.
RETRIEVAL_REDUNDANCY_ENABLED=true
# Hard wall-clock bound for one retrieval call; a stall returns the existing
# RETRIEVAL_UPSTREAM_UNAVAILABLE failure batch instead of holding the run.
RETRIEVAL_TIMEOUT_SECONDS=120
# Character-shingle Jaccard for same document/version/section; finite 0.85..1.
RETRIEVAL_REDUNDANCY_THRESHOLD=0.90
EVIDENCE_MAX_EXCERPT_CHARS=1200
# Must stay >= LLM_WORKFLOW_TIMEOUT_SECONDS with a bounded tail for finalization.
WORKFLOW_RUN_LEASE_SECONDS=1860
# SQLite 文本任务只由独立 generation_worker.py 消费；background 仅供 memory。
GENERATION_DISPATCH_MODE=worker
GENERATION_WORKER_POLL_SECONDS=2.0
GENERATION_WORKER_SHUTDOWN_SECONDS=30.0
# 仅旧 legacy 无 Run 任务按此超时失败；新的持久 queued 不按年龄失败。
GENERATION_QUEUE_TIMEOUT_SECONDS=1260
RESOURCE_WORKER_MAX_CONCURRENCY=2
RESOURCE_CONTINUATION_MAX_ITEMS=12
RESOURCE_CONTINUATION_SUMMARY_MAX_CHARS=600
WORKFLOW_CHECKPOINT_MAX_BYTES=65536
WORKFLOW_TIMELINE_DEFAULT_LIMIT=100
WORKFLOW_TIMELINE_MAX_LIMIT=500
# P0-08：SSE 只读持久化 WorkflowEvent；heartbeat 不写事件表
WORKFLOW_SSE_POLL_INTERVAL_SECONDS=0.5
WORKFLOW_SSE_HEARTBEAT_SECONDS=15
WORKFLOW_SSE_EVENT_PAGE_SIZE=100
# 动态报告的当前快照流；独立于 WorkflowEvent durable stream。
REPORT_SSE_POLL_INTERVAL_SECONDS=2
REPORT_SSE_HEARTBEAT_SECONDS=15
# P0-03 仅支持 cosine；分数会统一归一化到 [0, 1]
VECTOR_DISTANCE_METRIC=cosine

# 数据库配置（相对路径统一按 backend/ 解析）
# 可选值：memory（仅进程内、重启丢失） / sqlite（开发/演示默认） / postgresql
DB_TYPE=sqlite
DATABASE_URL=sqlite:///./data/domain_knowledge.db
# Concurrent workflow writes wait for a bounded time on SQLite locks.
SQLITE_BUSY_TIMEOUT_SECONDS=60

# 知识库路径（相对 backend/）
# 默认指向 RAG 工程训练示例知识库；接入其他领域时改为对应知识库目录。
KNOWLEDGE_BASE_DIR=../knowledge_base/rag_engineering_training
KNOWLEDGE_INDEX_STALE_SECONDS=900
# New model requires a new index; never point BGE-M3 at the old BGE-zh directory.
VECTOR_STORE_DIR=./data/chroma_bge_m3
# 多 KB 独立 collection 的默认前缀；实际名称为 <prefix>_<kb_id_hash>
CHROMA_COLLECTION_PREFIX=kb
# 兼容期旧变量：若设置且未显式设置 PREFIX，也按前缀解释，不再是唯一固定集合名
# CHROMA_COLLECTION_NAME=legacy_prefix

# CrossEncoder 精排配置（模型缓存目录相对 backend/，不会提交到 Git）
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MODEL_CACHE_DIR=./data/models
RERANK_DEVICE=cpu
RERANK_CANDIDATE_K=20
RERANK_PER_QUERY_K=10
RERANK_BATCH_SIZE=4
RERANK_MAX_LENGTH=512
RERANK_MAX_CHUNKS_PER_DOCUMENT=2

# 生成资源文件存储路径（相对 backend/）
RESOURCES_DIR=./data/generated_resources

# 可选管理员 KB 健康详情 token；留空时 /api/admin/knowledge-bases/health 关闭
ADMIN_HEALTH_TOKEN=

# 简易注册登录配置。生产环境必须替换密钥并启用 HTTPS Cookie。
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=training_pilot_token
AUTH_COOKIE_SECURE=false
# 凭据 CORS 白名单，JSON 数组。development/demo 另允许本机动态端口。
# production 必须替换 JWT 密钥（至少 32 字节随机值）、设 Secure=true，
# 并使用 HTTPS origins；同源部署可保留 []，不开放跨域凭据请求。
CORS_ALLOW_ORIGINS=[]

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SQL_ECHO=false

# T38: keep legacy until separately authorized live quality acceptance.
# legacy_content_v2 (default) | lecture_issue_v1 (T38) | lecture_issue_v2 (T39)
LECTURE_REVIEW_STRATEGY=legacy_content_v2
# Required only for lecture_issue_v1; use the confirmed model window.
# LECTURE_REVIEW_CONTEXT_TOKENS=

# T44/T45: generic text-document review. Explicit compat keeps the historical
# per-resource reviewers; resource_issue_v1 routes all six text resource types
# (讲义/实操指南/分阶测试题/案例分析/复习清单/个性化纠错训练包) through one
# shared versioned closed loop by default.
RESOURCE_REVIEW_STRATEGY=resource_issue_v1
# Required for the default resource_issue_v1; set the confirmed deployed model window.
# 129024 is the current local reviewer configuration; verify it for other models.
RESOURCE_REVIEW_CONTEXT_TOKENS=129024

# Claim business revisions are controlled by request.claim_max_iterations (default 1; explicit 0 disables).
# Exhausted Claim revisions never consume ordinary max_iterations. No additional environment variable.

# T50: optional Claim evidence retrieval. Off unless the request sets
# include_claim_evidence_retrieval=true together with include_claim_check and
# include_review. These are engineering limits frozen per Run (tokens/attempts/
# wall clock), not measured latency or cost. Unknown usage is never recorded as 0.
CLAIM_EVIDENCE_RETRIEVAL_QUERY_BATCH_CLAIMS=16
CLAIM_EVIDENCE_RETRIEVAL_REJUDGE_BATCH_CLAIMS=16
CLAIM_EVIDENCE_RETRIEVAL_QUERIES_PER_CLAIM=2
CLAIM_EVIDENCE_RETRIEVAL_MAX_QUERIES_PER_CLAIM=3
CLAIM_EVIDENCE_RETRIEVAL_MAX_QUERIES=96
CLAIM_EVIDENCE_RETRIEVAL_QUERIES_PER_REQUEST=6
CLAIM_EVIDENCE_RETRIEVAL_MAX_NEW_EXCERPTS_PER_RESOURCE=8
CLAIM_EVIDENCE_RETRIEVAL_MAX_NEW_EXCERPTS=16
CLAIM_EVIDENCE_RETRIEVAL_MAX_LOGICAL_CALLS=16
CLAIM_EVIDENCE_RETRIEVAL_MAX_ATTEMPTS=24
CLAIM_EVIDENCE_RETRIEVAL_ATTEMPTS_PER_CALL=3
CLAIM_EVIDENCE_RETRIEVAL_QUERY_INPUT_CAP=16384
CLAIM_EVIDENCE_RETRIEVAL_QUERY_OUTPUT_CAP=4096
CLAIM_EVIDENCE_RETRIEVAL_REJUDGE_INPUT_CAP=32768
CLAIM_EVIDENCE_RETRIEVAL_REJUDGE_OUTPUT_CAP=8192
CLAIM_EVIDENCE_RETRIEVAL_REJUDGE_TRUNCATED_OUTPUT_CAP=16384
CLAIM_EVIDENCE_RETRIEVAL_MAX_ESTIMATED_TOKENS=196608
CLAIM_EVIDENCE_RETRIEVAL_ATTEMPT_TIMEOUT_SECONDS=180
CLAIM_EVIDENCE_RETRIEVAL_RETRIEVAL_TIMEOUT_SECONDS=120
CLAIM_EVIDENCE_RETRIEVAL_MAX_WALL_SECONDS=600
CLAIM_EVIDENCE_RETRIEVAL_DOWNSTREAM_RESERVE_SECONDS=300
CLAIM_EVIDENCE_RETRIEVAL_EXCERPT_CHARS=2000
CLAIM_EVIDENCE_RETRIEVAL_EXCERPT_STRUCTURAL_CAP=4000
