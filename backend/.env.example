# 运行模式：development | demo | production
APP_MODE=development
# 仅 development/demo 可显式开启；production 永远禁止隐式降级
ALLOW_DEGRADED_GENERATION=false

# 大模型配置（支持 OpenAI 兼容接口；占位 Key 不能用于 production）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max

# 向量模型配置
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# 数据库配置（相对路径统一按 backend/ 解析）
# 可选值：memory（仅进程内、重启丢失） / sqlite（开发/演示默认） / postgresql
DB_TYPE=sqlite
DATABASE_URL=sqlite:///./data/domain_knowledge.db

# 知识库路径（相对 backend/）
# 默认指向 RAG 工程训练示例知识库；接入其他领域时改为对应知识库目录。
KNOWLEDGE_BASE_DIR=../knowledge_base/rag_engineering_training
VECTOR_STORE_DIR=./chroma_db
# 多 KB 独立 collection 的默认前缀；实际名称为 <prefix>_<kb_id_hash>
CHROMA_COLLECTION_PREFIX=kb
# 兼容期旧变量：若设置且未显式设置 PREFIX，也按前缀解释，不再是唯一固定集合名
# CHROMA_COLLECTION_NAME=legacy_prefix

# 生成资源文件存储路径（相对 backend/）
RESOURCES_DIR=./data/generated_resources

# 可选管理员 KB 健康详情 token；留空时 /api/admin/knowledge-bases/health 关闭
ADMIN_HEALTH_TOKEN=

# 简易注册登录配置。生产环境必须替换密钥并启用 HTTPS Cookie。
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=training_pilot_token
AUTH_COOKIE_SECURE=false

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
SQL_ECHO=false
