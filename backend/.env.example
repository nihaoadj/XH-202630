# 运行模式：development | demo | production
APP_MODE=development
# 仅 development/demo 可显式开启；production 永远禁止隐式降级
ALLOW_DEGRADED_GENERATION=false

# 大模型配置（支持 OpenAI 兼容接口；占位 Key 不能用于 production）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Provider-specific reasoning toggle; DeepSeek acceptance config sets this to disabled.
LLM_THINKING_MODE=auto
# Optional. Leave blank for direct model access; system proxy settings are ignored.
LLM_PROXY_URL=
# 单次 Provider 请求与整个资源级工作流的超时预算（秒）
LLM_REQUEST_TIMEOUT_SECONDS=120
# Claim 抽取/判定的独立预算；长资源不继承通用辅助节点限制。
CLAIM_REQUEST_TIMEOUT_SECONDS=240
CLAIM_RETRY_REQUEST_TIMEOUT_SECONDS=300
LLM_WORKFLOW_TIMEOUT_SECONDS=1200
# 含首次调用，允许范围 1-3；SDK 自带重试保持关闭
LLM_MAX_ATTEMPTS=2
CLAIM_MAX_ATTEMPTS=3
CLAIM_SCHEMA_REPAIR_ATTEMPTS=1
# Publish ordinary-review-approved resources with incomplete Claim metrics.
CLAIM_PARTIAL_PUBLISH=true
# Deprecated: evidence-gap resources now wait for an explicit user decision.
CLAIM_WARNING_PUBLISH_ENABLED=false
CLAIM_WARNING_PUBLISH_MIN_FACTUAL_PASS_RATE=0.80
# Completed Claim audits with evidence gaps enter user review at this rate.
CLAIM_USER_REVIEW_ENABLED=true
CLAIM_USER_REVIEW_MIN_FACTUAL_PASS_RATE=0.60
# 用户可见资源生成在空输出时允许额外一次有界恢复；审核等辅助节点仍使用上面的全局上限。
LLM_RESOURCE_GENERATION_MAX_ATTEMPTS=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=3.0
LLM_MAX_OUTPUT_TOKENS=16384
CLAIM_MAX_OUTPUT_TOKENS=32768
CLAIM_TRUNCATED_RETRY_OUTPUT_TOKENS=65536
# 每个资源最多抽取多少条 Claim；同时约束提示词和服务端抽取结果。
CLAIM_MAX_CLAIMS_PER_RESOURCE=10
# 兼容旧部署；新资源 Agent 使用下方的显式预算。
LLM_GENERATOR_MAX_OUTPUT_TOKENS=16384
LLM_RESOURCE_GENERATOR_MAX_INPUT_TOKENS=65536
LLM_RESOURCE_GENERATOR_MAX_OUTPUT_TOKENS=65536
# 讲义使用单独的、有界长文预算：给完整 Markdown 留余量，但不继承通用 32k 输出预算。
TEXT_RESOURCE_REQUEST_TIMEOUT_SECONDS=240
TEXT_RESOURCE_MAX_OUTPUT_TOKENS=65536
# 实操指南先生成严格 JSON（最多 8 步），再确定性拼接为 Markdown；保留更高的独立预算。
PRACTICE_GUIDE_REQUEST_TIMEOUT_SECONDS=300
PRACTICE_GUIDE_MAX_OUTPUT_TOKENS=65536
# auto | json_schema | function_calling | json_mode | text
# OpenAI-compatible 服务若不支持 function calling，请显式设为 text，
# 避免每个 Agent 先发生一次 BAD_REQUEST 再回退；不要修改真实密钥文件入库。
LLM_STRUCTURED_OUTPUT_MODE=json_mode

# 互动课件自动审核：达到修订或时间预算即隔离，不等待人工批准。
# Normal courseware authoring is AI-first.  Set false only for an explicit
# emergency-degraded operation; local tests inject a non-network fake gateway.
COURSEWARE_AI_ENABLED=true
COURSEWARE_GENERATION_MODE=ai_first
COURSEWARE_AUTO_REVISION_MAX_ATTEMPTS=3
COURSEWARE_SCENE_LEASE_SECONDS=120
COURSEWARE_AUTO_REVIEW_MAX_SECONDS=180
# 分阶段 token/时延预算；质量审核和修订预留额度不可被前序阶段占用
COURSEWARE_PLANNER_TOKEN_BUDGET=16384
COURSEWARE_TOTAL_LLM_TOKEN_BUDGET=147456
COURSEWARE_SCENE_COMPOSITION_TOKEN_BUDGET=81920
COURSEWARE_SCENE_CALL_MAX_TOKENS=8192
COURSEWARE_QUALITY_REVIEW_TOKEN_BUDGET=16384
COURSEWARE_REVISION_TOKEN_BUDGET=32768
COURSEWARE_QUALITY_REVIEW_RESERVED_TOKENS=16384
COURSEWARE_REVISION_RESERVED_TOKENS=32768
COURSEWARE_PLANNER_MAX_SECONDS=90
COURSEWARE_TOTAL_RUN_TIMEOUT_SECONDS=1050
COURSEWARE_SCENE_COMPOSITION_MAX_SECONDS=600
COURSEWARE_QUALITY_REVIEW_MAX_SECONDS=120
COURSEWARE_REVISION_MAX_SECONDS=180
COURSEWARE_QUALITY_REVIEW_RESERVED_SECONDS=120
COURSEWARE_REVISION_RESERVED_SECONDS=180
# 兼容旧配置；Web 不会自动启动 Worker，请运行 backend/scripts/courseware_worker.py
COURSEWARE_WORKER_ENABLED=false
COURSEWARE_WORKER_POLL_SECONDS=2
COURSEWARE_WORKER_BATCH_SIZE=1
# SQLite schedules one sequential Worker. Values above 1 are normalized to 1
# so an unstarted task never holds an expiring lease.
COURSEWARE_WORKER_HEALTH_HOST=127.0.0.1
COURSEWARE_WORKER_HEALTH_PORT=8081
COURSEWARE_INPUT_COST_PER_1K_TOKENS=0
COURSEWARE_OUTPUT_COST_PER_1K_TOKENS=0

# C0 live-model acceptance: every field is required by the manual job; these
# are metadata only and never contain the API key. Missing fields are reported
# as CONFIG_MISSING and cannot be reported as passed.
COURSEWARE_LIVE_MODEL_CONFIG_VERSION=2
COURSEWARE_LIVE_MODEL_PROVIDER=
COURSEWARE_LIVE_MODEL_BASE_URL=
COURSEWARE_LIVE_MODEL=
COURSEWARE_LIVE_STRUCTURED_OUTPUT_MODE=json_mode
COURSEWARE_LIVE_TIMEOUT_SECONDS=60
COURSEWARE_LIVE_MAX_ATTEMPTS=2
COURSEWARE_LIVE_RETRY_BASE_DELAY_SECONDS=0.5
COURSEWARE_LIVE_RETRY_MAX_DELAY_SECONDS=3
COURSEWARE_LIVE_INPUT_PRICE_PER_1K_TOKENS=
COURSEWARE_LIVE_OUTPUT_PRICE_PER_1K_TOKENS=
COURSEWARE_LIVE_PRICE_CURRENCY=USD
COURSEWARE_LIVE_PRICE_VERSION=
COURSEWARE_LIVE_PRICE_EFFECTIVE_DATE=2026-08-24
# COURSEWARE_LIVE_EVAL=1 is required for real calls; LLM_API_KEY is read only
# from the process environment and is never written to a report.
COURSEWARE_LIVE_EVAL=0

# Tutor 独立交互预算；仍复用全局 LLMGateway 的重试和错误语义
TUTOR_LLM_TIMEOUT_SECONDS=25
TUTOR_MAX_OUTPUT_TOKENS=4096
TUTOR_MAX_CONTEXT_TURNS=6
TUTOR_MAX_EVIDENCE_ITEMS=4
TUTOR_MAX_HINT_LEVEL=3

# 向量模型配置
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# Require the pre-provisioned local embedding model at runtime. Set false only
# while explicitly provisioning model files on a trusted network.
EMBEDDING_LOCAL_FILES_ONLY=true

# P0-03 Evidence 检索策略（请求只能在 1-10 范围覆盖 top-k）
RETRIEVAL_TOP_K_DEFAULT=3
RETRIEVAL_MAX_QUERIES=6
RETRIEVAL_MAX_EVIDENCE=8
RETRIEVAL_MIN_EVIDENCE=1
RETRIEVAL_MIN_NORMALIZED_SCORE=0.35
EVIDENCE_MAX_EXCERPT_CHARS=1200
WORKFLOW_RUN_LEASE_SECONDS=1260
RESOURCE_WORKER_MAX_CONCURRENCY=2
RESOURCE_CONTINUATION_MAX_ITEMS=12
RESOURCE_CONTINUATION_SUMMARY_MAX_CHARS=600
WORKFLOW_CHECKPOINT_MAX_BYTES=65536
WORKFLOW_TIMELINE_DEFAULT_LIMIT=100
WORKFLOW_TIMELINE_MAX_LIMIT=500
# P0-08：SSE 只读持久化 WorkflowEvent；heartbeat 不写事件表
WORKFLOW_SSE_POLL_INTERVAL_SECONDS=0.5
WORKFLOW_SSE_HEARTBEAT_SECONDS=15
WORKFLOW_SSE_EVENT_PAGE_SIZE=100
# 动态报告的当前快照流；独立于 WorkflowEvent durable stream。
REPORT_SSE_POLL_INTERVAL_SECONDS=2
REPORT_SSE_HEARTBEAT_SECONDS=15
# P0-03 仅支持 cosine；分数会统一归一化到 [0, 1]
VECTOR_DISTANCE_METRIC=cosine

# 数据库配置（相对路径统一按 backend/ 解析）
# 可选值：memory（仅进程内、重启丢失） / sqlite（开发/演示默认） / postgresql
DB_TYPE=sqlite
DATABASE_URL=sqlite:///./data/domain_knowledge.db
# Concurrent workflow writes wait for a bounded time on SQLite locks.
SQLITE_BUSY_TIMEOUT_SECONDS=60

# 知识库路径（相对 backend/）
# 默认指向 RAG 工程训练示例知识库；接入其他领域时改为对应知识库目录。
KNOWLEDGE_BASE_DIR=../knowledge_base/rag_engineering_training
KNOWLEDGE_INDEX_STALE_SECONDS=900
VECTOR_STORE_DIR=./chroma_db
# 多 KB 独立 collection 的默认前缀；实际名称为 <prefix>_<kb_id_hash>
CHROMA_COLLECTION_PREFIX=kb
# 兼容期旧变量：若设置且未显式设置 PREFIX，也按前缀解释，不再是唯一固定集合名
# CHROMA_COLLECTION_NAME=legacy_prefix

# CrossEncoder 精排配置（模型缓存目录相对 backend/，不会提交到 Git）
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MODEL_CACHE_DIR=./data/models
RERANK_DEVICE=cpu
RERANK_CANDIDATE_K=20
RERANK_PER_QUERY_K=10
RERANK_BATCH_SIZE=4
RERANK_MAX_LENGTH=512
RERANK_MAX_CHUNKS_PER_DOCUMENT=2

# 生成资源文件存储路径（相对 backend/）
RESOURCES_DIR=./data/generated_resources

# 可选管理员 KB 健康详情 token；留空时 /api/admin/knowledge-bases/health 关闭
ADMIN_HEALTH_TOKEN=

# 简易注册登录配置。生产环境必须替换密钥并启用 HTTPS Cookie。
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=training_pilot_token
AUTH_COOKIE_SECURE=false

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SQL_ECHO=false
