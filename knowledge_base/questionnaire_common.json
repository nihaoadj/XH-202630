{
  "questionnaire_id": "common_initial_profile_v1",
  "scope": "common",
  "name": "通用初始画像问卷",
  "description": "用于所有学习方向的初始画像采集，收集学习者基本信息、学习要求、偏好和时间投入。问卷只用于画像构建和测评范围建议，不用于真实判定掌握情况。",
  "version": "1.0.0",
  "enabled": true,
  "questions": [
    {
      "question_id": "identity",
      "field_key": "identity",
      "title": "你目前的身份是？",
      "type": "single_choice",
      "required": true,
      "sort_order": 10,
      "options": [
        {"label": "在校学生", "value": "在校学生", "profile_value": "在校学生"},
        {"label": "已工作，技术岗位", "value": "已工作，技术岗位", "profile_value": "职场学习者"},
        {"label": "已工作，非技术岗位，准备转向 AI 方向", "value": "已工作，非技术岗位，准备转向 AI 方向", "profile_value": "转行学习者"},
        {"label": "其他", "value": "其他", "profile_value": "其他"}
      ],
      "profile_mapping": {"target_path": "learner_type", "transform": "option.profile_value"}
    },
    {
      "question_id": "education",
      "field_key": "education",
      "title": "你的当前学历或教育阶段是？",
      "type": "single_choice_or_other",
      "required": true,
      "sort_order": 20,
      "options": [
        {"label": "高中/中职", "value": "高中/中职"},
        {"label": "专科", "value": "专科"},
        {"label": "本科", "value": "本科"},
        {"label": "硕士及以上", "value": "硕士及以上"},
        {"label": "已毕业/在职", "value": "已毕业/在职"},
        {"label": "其他", "value": "其他"}
      ],
      "profile_mapping": {"target_path": "education", "transform": "answer"}
    },
    {
      "question_id": "major",
      "field_key": "major",
      "title": "你的专业或当前岗位方向是？",
      "type": "text",
      "required": true,
      "sort_order": 30,
      "hint": "例如：软件工程、机械工程、后端开发、产品运营",
      "profile_mapping": {"target_path": "major", "transform": "answer"}
    },
    {
      "question_id": "learning_goals",
      "field_key": "learning_goals",
      "title": "你的主要学习目标是？",
      "type": "multiple_choice",
      "required": true,
      "sort_order": 40,
      "options": [
        {"label": "了解基础概念", "value": "了解基础概念"},
        {"label": "能完成一个入门项目", "value": "能完成一个入门项目"},
        {"label": "能解决实际工作或比赛问题", "value": "能解决实际工作或比赛问题"},
        {"label": "为比赛/项目开发做准备", "value": "为比赛/项目开发做准备"},
        {"label": "为面试/转岗做准备", "value": "为面试/转岗做准备"}
      ],
      "profile_mapping": {"target_path": "learning_goal", "transform": "join_semicolon"}
    },
    {
      "question_id": "desired_resource_types",
      "field_key": "desired_resource_types",
      "title": "希望系统优先生成哪些学习资源？",
      "type": "multiple_choice",
      "required": false,
      "sort_order": 50,
      "options": [
        {"label": "图解讲义", "value": "图解讲义"},
        {"label": "一步步实操教程", "value": "一步步实操教程"},
        {"label": "代码模板", "value": "代码模板"},
        {"label": "分阶测试题", "value": "分阶测试题"},
        {"label": "项目案例", "value": "项目案例"},
        {"label": "调参建议", "value": "调参建议"},
        {"label": "面试/转岗建议", "value": "面试/转岗建议"}
      ],
      "profile_mapping": {"target_path": "learning_preferences.preferred_resource_types", "transform": "answer"}
    },
    {
      "question_id": "learning_modes",
      "field_key": "learning_modes",
      "title": "你偏好的学习方式是？",
      "type": "multiple_choice",
      "required": false,
      "sort_order": 60,
      "options": [
        {"label": "先讲概念，再做练习", "value": "先讲概念，再做练习"},
        {"label": "直接做项目，边做边学", "value": "直接做项目，边做边学"},
        {"label": "看代码案例理解", "value": "看代码案例理解"},
        {"label": "看图解和类比理解", "value": "看图解和类比理解"},
        {"label": "先做测试，系统根据薄弱点推荐内容", "value": "先做测试，系统根据薄弱点推荐内容"}
      ],
      "profile_mapping": {"target_path": "learning_preferences.metadata.onboarding.learning_modes", "transform": "answer"}
    },
    {
      "question_id": "difficulty_preference",
      "field_key": "difficulty_preference",
      "title": "你希望第一轮学习资源的难度如何？",
      "type": "single_choice",
      "required": false,
      "sort_order": 70,
      "options": [
        {"label": "自适应推荐", "value": "自适应推荐"},
        {"label": "从基础开始", "value": "从基础开始"},
        {"label": "保持当前水平", "value": "保持当前水平"},
        {"label": "优先挑战进阶内容", "value": "优先挑战进阶内容"}
      ],
      "profile_mapping": {"target_path": "learning_preferences.difficulty_preference", "transform": "answer"}
    },
    {
      "question_id": "weekly_time_budget",
      "field_key": "weekly_time_budget",
      "title": "你每周大概能投入多少时间学习？",
      "type": "single_choice",
      "required": false,
      "sort_order": 80,
      "options": [
        {"label": "0.5-1 小时", "value": "0.5-1 小时"},
        {"label": "1-2 小时", "value": "1-2 小时"},
        {"label": "2-4 小时", "value": "2-4 小时"},
        {"label": "4-6 小时", "value": "4-6 小时"},
        {"label": "6 小时以上", "value": "6 小时以上"}
      ],
      "profile_mapping": {"target_path": "learning_preferences.metadata.onboarding.weekly_time_budget", "transform": "answer"}
    }
  ]
}
